<?xml version="1.0"?>
<model>
  <name>emir_aircraft_temp</name>
  <version>1.0</version>
  <sdf version='1.5'>model.sdf</sdf>

  <author>
    <name>Roman Bapst (original) / Bumblebee A-B copy</name>
    <email>roman@px4.io</email>
  </author>

  <description>
    A/B reference model copied from emir-gazebo-plane in iq_sim.
The camera matches the hardware specification: 1920x1080, nominal hfov
0.42 rad, near 0.1, 30 Hz, /webcam/image_raw, and visualize false.
Physics, mass, LiftDrag, ArduPilotPlugin channels, and the internal model
name emir-gazebo-plane remain identical to the original. Scoped joint
and IMU names beginning with emir-gazebo-plane:: depend on that model
name. Keep the external iq_sim model unchanged.
  </description>
</model>
