<?xml version="1.0"?>
<model>
  <name>emir_ucak_temp</name>
  <version>1.0</version>
  <sdf version='1.5'>model.sdf</sdf>

  <author>
    <name>Roman Bapst (orijinal) / bumblebee A-B kopyasi</name>
    <email>roman@px4.io</email>
  </author>

  <description>
    A/B kontrol modeli: iq_sim'deki emir-gazebo-plane'in AYNEN kopyasi;
    TEK fark kamera sensorunun gercek donanim spec'ine cevrilmesidir
    (1920x1080, hfov 0.42 rad, near 0.1, 30 Hz, /webcam/image_raw,
    visualize false). Fizik, kutle, LiftDrag, ArduPilotPlugin kanallari
    ve model adi ('emir-gazebo-plane') orijinalle BIREBIR aynidir; model
    adi degistirilmedi cunku eklenti icindeki scoped joint/imu adlari
    (emir-gazebo-plane::...) ona bagli.
    iq_sim altindaki orijinal modele DOKUNULMAZ.
  </description>
</model>
