<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <physics type="ode">
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.0</sor></solver>
        <!-- GROUND THEME: EXACTLY as iq_sim/emir_multi_uav.world (reference emir_guidance.sh).            The previous values ​​of 100.0 / 0.001 were for BUMBLEBEE (the 12 kg taildragger was buried in the ground with 0.1). Bumblebee abandoned -> reverted to proven reference. -->
        <constraints><cfm>0.0</cfm><erp>0.9</erp><contact_max_correcting_vel>0.1</contact_max_correcting_vel><contact_surface_layer>0.0</contact_surface_layer></constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
    <scene>
      <sky><clouds><speed>12</speed></clouds></sky>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.25 0.25 0.25 1</background>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>5000 5000</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="runway">
          <pose>0 0 0.005 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>1829 45</size></plane></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Runway</name></script></material>
        </visual>
        <visual name="grass">
          <pose>0 0 -0.1 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>5000 5000</size></plane></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grass</name></script></material>
        </visual>
      </link>
    </model>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- A/B CONTROL WORLD: EXACTLY the same as bumblebee_multi_uav.world (physics, track, lighting, target, poses); The ONLY difference is the fighter model.          hunter = model://emir_aircraft_temp (commissioned aircraft known to be operational, but copy with camera converted to real spec). -->
    <model name="hunter">
      <include><uri>model://emir_aircraft_temp</uri></include>
      <pose>0 0 0 0 0 0</pose>
    </model>
    <!-- Purple target, 2026-07-28. models/purple_target is a local copy of
emir-gazebo-plane2 from iq_sim. Its visual material is Gazebo/Purple
(RGB 1 0 1, OpenCV HSV H=150). Physics, mass, LiftDrag, ArduPilotPlugin,
the SDF model name emir-gazebo-plane2, and ports 9012/9013 are unchanged.
The world retains its sky, runway, and grass. bbox_to_redis.py detects
purple, whose H 140-160 window excludes the sky horizon band near H=112
and ground artifacts near H=0-49. The external iq_sim model is unchanged. -->
    <model name="target">
      <include><uri>model://purple_target</uri></include>
      <pose>20 0 0 0 0 0</pose>
    </model>
  </world>
</sdf>
